root = true

# Ficheros nuevos (backend/, frontend/, contracts/, deploy/, docs/, specs/).
# El legacy (src/, web/) conserva su codificación original: no se reescribe.
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.java]
indent_size = 4

[*.md]
trim_trailing_whitespace = false

[{src,web}/**]
charset = unset
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
indent_style = unset
indent_size = unset
