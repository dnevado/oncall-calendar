<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="es.medoncalls.guardias.cambios.infrastructure.VacacionesMapper">

  <select id="selectDias" resultType="es.medoncalls.guardias.cambios.infrastructure.VacacionFila">
    SELECT v.IdMedico AS medicoId, v.FDay AS dia
      FROM vacaciones_medicos v
     WHERE v.IdMedico IN <foreach collection="medicoIds" item="id" open="(" separator="," close=")">#{id}</foreach>
       AND v.FDay IN <foreach collection="dias" item="d" open="(" separator="," close=")">#{d}</foreach>
  </select>
</mapper>
